{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeffreyearly.github.io/spectral-kernel-benchmarks/schema/spectral-kernel-machine-tuning-v1.schema.json",
  "title": "Spectral kernel benchmark-local machine tuning manifest v1",
  "type": "object",
  "required": [
    "schema",
    "experimentId",
    "classification",
    "intendedUse",
    "productionValidated",
    "machine",
    "identity",
    "compatibilityHash",
    "implementations",
    "profiles",
    "fixtures",
    "candidatePolicy",
    "capacityPolicy",
    "candidateMatrix",
    "threadEnvironment",
    "warmups",
    "samples",
    "runs",
    "analysis"
  ],
  "properties": {
    "schema": {"const": "spectral-kernel-machine-tuning-v1"},
    "experimentId": {"const": "issue-023-portable-tuning-reference-campaign"},
    "classification": {"const": "preliminary"},
    "intendedUse": {"const": "benchmark-local-provisional-default"},
    "productionValidated": {"const": false},
    "machine": {
      "type": "object",
      "required": [
        "hostname",
        "cpuBrand",
        "hardwareModel",
        "performanceCores",
        "efficiencyCores",
        "totalPhysicalCores",
        "physicalMemoryBytes"
      ],
      "properties": {
        "performanceCores": {"type": "integer", "minimum": 1},
        "efficiencyCores": {"type": "integer", "minimum": 0},
        "totalPhysicalCores": {"type": "integer", "minimum": 1},
        "physicalMemoryBytes": {"type": "integer", "minimum": 0}
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "sourceTreeGitCommit",
        "sourceTreeDirty",
        "executablePath",
        "executableSha256",
        "implementationContractHashes",
        "fixtureHashes"
      ]
    },
    "compatibilityHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "implementations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "boundary",
          "kernel",
          "fixture_kind",
          "provider",
          "representation",
          "mathematical_boundary",
          "knobs",
          "frozen",
          "contractHash"
        ]
      }
    },
    "profiles": {
      "const": [
        "wvm-current-256-nz129-f4",
        "wvm-current-512-nz257-f4"
      ]
    },
    "fixtures": {"type": "object"},
    "candidatePolicy": {
      "type": "object",
      "required": ["counts", "search", "nestedWorkerPools", "oneTupleForAllWorkloads"],
      "properties": {
        "nestedWorkerPools": {"const": false},
        "oneTupleForAllWorkloads": {"const": true}
      }
    },
    "capacityPolicy": {
      "type": "object",
      "required": ["physicalMemoryBytes", "calibrationWorkloadsOnly", "disposition"],
      "properties": {
        "physicalMemoryBytes": {"type": "integer", "minimum": 0},
        "calibrationWorkloadsOnly": {"const": true}
      }
    },
    "candidateMatrix": {"type": "object"},
    "threadEnvironment": {
      "type": "object",
      "properties": {"VECLIB_MAXIMUM_THREADS": {"const": "1"}},
      "required": ["VECLIB_MAXIMUM_THREADS"]
    },
    "warmups": {"type": "integer", "minimum": 1},
    "samples": {"type": "integer", "minimum": 1},
    "runs": {"type": "array"},
    "analysis": {"type": "object"}
  },
  "additionalProperties": true
}
